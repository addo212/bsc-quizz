{
  "name": "bsc-quiz",
  "version": "0.1.0",
  "private": true,
  "description": "BSC Quiz — alternatif Kahoot open source (Next.js + Supabase)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:sync": "node scripts/sync-supabase-migration.mjs",
    "db:start": "npx --yes supabase@latest start",
    "db:stop": "npx --yes supabase@latest stop",
    "db:status": "npx --yes supabase@latest status",
    "db:reset": "npx --yes supabase@latest db reset"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.0.1",
    "@mdx-js/react": "^3.0.1",
    "@next/mdx": "^14.2.5",
    "@supabase/supabase-js": "^2.42.0",
    "@types/mdx": "^2.0.13",
    "next": "14.2.15",
    "next-qrcode": "^2.5.1",
    "react": "^18",
    "react-confetti": "^6.1.0",
    "react-dom": "^18",
    "react-use": "^17.5.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "14.0.4",
    "postcss": "^8",
    "tailwindcss": "^3.3.0",
    "typescript": "^5"
  }
}