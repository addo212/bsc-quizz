# ---------------------------------------------------------------------------
# Salin file ini menjadi `.env.local` lalu isi nilainya.
#
# Ada dua cara menyiapkan database — pilih salah satu:
#
#   Cara A (disarankan) : Supabase Cloud, gratis, tanpa install apa pun.
#                         Ambil nilainya dari Supabase Dashboard ->
#                         Project Settings -> API
#
#   Cara B              : Supabase lokal via Docker Desktop.
#                         Jalankan `npm run db:start` lalu `npm run db:status`.
#                         URL selalu http://127.0.0.1:54321
# ---------------------------------------------------------------------------

# --- Contoh Cara A (Supabase Cloud) ---------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Contoh Cara B (Supabase lokal) ---------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<salin dari output `npm run db:status`>

# Kunci "anon public" / "publishable" — aman dipakai di browser
# karena semua akses dilindungi Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Opsional — dipakai untuk membuat tautan & QR code "gabung permainan".
# Kalau dikosongkan, aplikasi otomatis memakai alamat browser saat ini.
# Isi tanpa garis miring di akhir.
#
#   lokal          : http://localhost:3000
#   dari HP via LAN: http://192.168.1.5:3000   (alamat LAN komputer Anda)
#   produksi       : https://bsc-quiz.vercel.app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
